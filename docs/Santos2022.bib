abstract = {If {\$}A{\$} is an infinite Boolean algebra the cardinal invariant {\$}\backslashmathfrak{\{}a{\}}(A){\$} is defined as the smallest size of an infinite partition of {\$}A{\$}. The cardinal {\$}\backslashmathfrak{\{}a{\}}(A\backslashoplus B){\$}, where {\$}A\backslashoplus B{\$} is the free product of the Boolean algebras {\$}A{\$} and {\$}B{\$} (whose dual topological space is the product of the dual topological spaces of {\$}A{\$} and {\$}B{\$}), is below both {\$}\backslashmathfrak{\{}a{\}}(A){\$} and {\$}\backslashmathfrak{\{}a{\}}(B){\$}. The equality {\$}\backslashmathfrak{\{}a{\}}(A\backslashoplus B)=\backslashmin\backslashlbrace\backslashmathfrak{\{}a{\}}(A),\backslashmathfrak{\{}a{\}}(B)\backslashrbrace{\$} is not known to hold for all infinite Boolean algebras {\$}A{\$} and {\$}B{\$}. Here some lower bounds of {\$}\backslashmathfrak{\{}a{\}}(A\backslashoplus B){\$} are provided.},
