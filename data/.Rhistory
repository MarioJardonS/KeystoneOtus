names(bin_vector_mas_1) <- names(bin_vector)
if (bin_vector["Coprobacillus"] == 1) { bin_vector_mas_1["Akkermansia"] <- 1 }else{ bin_vector_mas_1["Akkermansia"] <- 0 }
if ( (bin_vector["Other"] == 1    |  bin_vector["Lachnospiraceae"] == 1)) { bin_vector_mas_1["Barnesiella"] <- 1}else{ bin_vector_mas_1["Barnesiella"] <- 0 }
if (( bin_vector["Enterococcus"] == 1 | bin_vector["Blautia"] == 1) | (( bin_vector["Blautia"] == 0 &  bin_vector["Coprobacillus"] == 1) | (( bin_vector["Blautia"] == 1 &  bin_vector["Coprobacillus"] == 0))) ) {bin_vector_mas_1["Blautia"] <- 1}else{bin_vector_mas_1["Blautia"] <- 0}
if ( bin_vector["Clostridium"] == 1 & bin_vector["Barnesiella"]  == 0 ) { bin_vector_mas_1["Clostridium"] <- 1}else{ bin_vector_mas_1["Clostridium"] <- 0}
if (bin_vector["Mollicutes"] == 1 | bin_vector[ "Enterobacteriaceae" ] == 1 | bin_vector["Coprobacillus"] == 0 | bin_vector["Clostridium"] == 1 | bin_vector["Blautia"] == 1 ){ bin_vector_mas_1["Enterococcus"] == 1 }else{ bin_vector_mas_1["Enterococcus"] == 0 }
if (( bin_vector["Other"] == 1 | bin_vector["Lachnospiraceae"] == 1)) {bin_vector_mas_1["Lachnospiraceae"] == 1}else{bin_vector_mas_1["Lachnospiraceae"] == 0}
if (( bin_vector["Other"] == 1 | bin_vector["Lachnospiraceae"] == 1)){bin_vector_mas_1["Other"] == 1}else{bin_vector_mas_1["Other"] == 0}
return(bin_vector_mas_1)
}
muestras <- sample(1:21026 , 10)
for (m in muestras){
vec <- data[ , m]
print(m)
for (i in 1:10){
print(vec)
vec <- next_step(vec)
}
}
library(BoolNet)
data <- read.csv("Camda25_gut/DataSets/CAMDA_2025/reduced_taxa.csv" , row.names = 1)
data_vieja <- read.csv("Camda25_gut/DataSets/CAMDA_2025/lineage_article.csv" )
Clostridium <- colSums(data_vieja[which(data_vieja[ , "g"] == "g__Clostridium")  , 8:dim(data_vieja)[2] ])
data <- rbind(data , Clostridium)
row.names(data)[10] <- "Clostridium"
filtro <- c()
for ( i in 1:dim(data)[1]){
if ( sum(data[i , ]) > 0 ){
filtro <- c(filtro , i)
}
}
data <- data[filtro , ]
data_bin <- binarizeTimeSeries( as.matrix(data) , method = "kmeans")
data <- data_bin[[1]]
